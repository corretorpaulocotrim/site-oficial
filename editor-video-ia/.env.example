# Copie para .env e ajuste. NUNCA coloque este arquivo no GitHub com chaves reais.

# Rede: 127.0.0.1 = só este computador (padrão). 0.0.0.0 = acessível pela rede/servidor (EXIGE APP_SENHA).
HOST=127.0.0.1
PORT=3333
# APP_SENHA=troque-por-uma-senha-forte

# Onde ficam projetos, mídias, renders e modelos de IA (faça backup desta pasta)
# DADOS_DIR=./dados
MAX_UPLOAD_MB=4096
RETENCAO_TMP_DIAS=3
# Quantas renderizações ao mesmo tempo (1 é o ideal num computador comum)
CONCORRENCIA=1

# Legendas (local, gratuito). Para mais precisão e mais lentidão: onnx-community/whisper-small_timestamped
WHISPER_MODELO=onnx-community/whisper-base_timestamped
# OCR de páginas escaneadas (local, gratuito). 0 desliga.
OCR=1

# --- OPCIONAIS PAGOS (deixe vazio para não usar) ---
# Roteiro refinado com Claude (Anthropic) — cobrado por uso
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODELO=claude-opus-5-5
# Voz sintética autorizada (ElevenLabs) — cobrado por caractere
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOZ=

# Site oficial (catálogo de empreendimentos e capas)
SITE_URL=https://paulocotrim.com.br
